export MASTERS_ACCOUNT=masters-sonata.testnet
export PLATFORM_ACCOUNT=platform-sonata.testnet
export MARKET_ACCOUNT=market-sonata.testnet
export ORACLE_ACCOUNT=oracle-sonata.testnet

# Demo people.
export NADIA_ACCOUNT=nadia-sonata.testnet
export KOFI_ACCOUNT=kofi-sonata.testnet
export LENA_ACCOUNT=lena-sonata.testnet
