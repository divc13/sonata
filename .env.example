# Database
DATABASE_URL=

# Auth
AUTH_URL=
AUTH_SECRET=

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email
RESEND_API_KEY=
EMAIL_FROM=

# Playback
JIOSAAVN_DES_KEY=

# Web
NEXT_PUBLIC_APP_URL=
UMAMI_WEBSITE_ID=

# Rate limiting
ENABLE_RATE_LIMITING=
TRUSTED_PROXY=
RATE_LIMITING_REQUESTS_PER_SECOND=

# Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sonata chain endpoint (server-side only; read by packages/near and the ops
# scripts, never shipped to the browser). Defaults to FastNear, which does not
# throttle view-call bursts like rpc.testnet.near.org now does.
SONATA_NEAR_RPC_URL=https://rpc.testnet.fastnear.com

# Sonata demo chain signers (server-only; never use NEXT_PUBLIC_ prefixes)
# Leave empty to keep every chain mutation disabled.
SONATA_DEMO_MODE=false
SONATA_DEMO_LISTENER_SECRET_KEY=
SONATA_DEMO_COLLECTOR_SECRET_KEY=
SONATA_ORACLE_SECRET_KEY=
SONATA_NADIA_SECRET_KEY=

# Pinata / IPFS (optional, server-only; used only by scripts/upload-pinata.ts)
# Leave empty to keep the demo on the committed files in apps/web/public/demo.
# Never prefix either value with NEXT_PUBLIC_ or commit a real token.
PINATA_JWT=
# Optional dedicated gateway base, e.g. https://your-gateway.mypinata.cloud/ipfs
PINATA_GATEWAY=
